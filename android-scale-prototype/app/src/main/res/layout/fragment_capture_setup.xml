<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/SfCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/SfSectionTitle"
            android:text="@string/title_capture_setup" />

        <TextView
            style="@style/SfFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_tipo_captura"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/radioGroupModo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radioModoPesaje"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/modo_pesaje"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioModoCalidad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/modo_solo_calidad" />
        </RadioGroup>

        <TextView
            style="@style/SfFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_plantel" />

        <Spinner
            android:id="@+id/spinnerPlantel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- Los campos de texto llevan etiqueta fija además del hint: el hint desaparece al
             escribir y sin etiqueta era fácil escribir el dato en la casilla equivocada. -->
        <TextView
            style="@style/SfFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_campania" />

        <EditText
            android:id="@+id/editCampania"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_campania"
            android:layout_marginBottom="12dp" />

        <TextView
            style="@style/SfFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_galpon" />

        <EditText
            android:id="@+id/editGalpon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_galpon"
            android:layout_marginBottom="12dp" />

        <TextView
            style="@style/SfFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_sexo"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/radioGroupCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radioMacho"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/categoria_macho"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioHembra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/categoria_hembra" />

            <RadioButton
                android:id="@+id/radioMediano"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/categoria_mediano" />
        </RadioGroup>

        <TextView
            style="@style/SfFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_corral" />

        <!-- Son 4 corrales por galpón (A-D). Va como selector para evitar erratas y para que
             cambiar de corral sea un toque; "Otro" deja escribirlo si algún galpón no usa A-D. -->
        <Spinner
            android:id="@+id/spinnerCorral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editCorralOtro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_corral_otro"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textCorralHechos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/sf_green"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/SfFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_edad" />

        <EditText
            android:id="@+id/editEdad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_edad"
            android:inputType="number"
            android:layout_marginBottom="12dp" />

        <TextView
            style="@style/SfFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_linea"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerLinea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            style="@style/SfFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_lote"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/radioGroupLote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radioLoteJ"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lote_j"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioLoteA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lote_a" />
        </RadioGroup>

        <TextView
            style="@style/SfFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_n_aves_pesada"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerNAvesPesada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonStartCapture"
            style="@style/SfButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_start_capture" />

        <ProgressBar
            android:id="@+id/progressSetup"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textSetupError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sf_red"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
